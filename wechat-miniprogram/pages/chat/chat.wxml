<view class="shell">
  <view class="toolbar"><view><view class="brand">Protein Space</view><text class="subtitle">随时开启一段新对话</text></view><button size="mini" bindtap="toggleSettings" disabled="{{busy || loading}}">设置</button></view>
  <view wx:if="{{settings}}" class="settings">
    <text class="label">服务地址</text><input value="{{base}}" data-field="base" bindinput="field" placeholder="https://linpro.top" disabled="{{loading}}"/>
    <text class="label">个人 API Key</text><input value="{{key}}" data-field="key" bindinput="field" password placeholder="waf_…（白名单用户可留空）" disabled="{{loading}}"/>
    <text class="hint">使用网页账户创建的 Key，仅在本次小程序会话中保留。</text><button class="primary" bindtap="connect" loading="{{loading}}" disabled="{{loading}}">连接服务</button>
  </view>
  <view class="actions"><button size="mini" bindtap="newChat" disabled="{{busy || loading}}">＋ 新对话</button><button size="mini" bindtap="history" disabled="{{!connected || busy || loading}}">历史记录</button><picker range="{{models}}" range-key="id" value="{{modelIndex}}" bindchange="chooseModel" disabled="{{!connected || busy || loading}}"><view class="model">{{models[modelIndex].id || '未连接'}} ▾</view></picker></view>
  <view wx:if="{{error}}" class="error"><text selectable>{{error}}</text></view>
  <scroll-view class="messages" scroll-y scroll-into-view="{{anchor}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="empty"><view class="orb">P</view><view class="welcome">今天想聊些什么？</view><text>提一个问题，让想法更进一步。</text></view>
    <view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}"><view class="role">{{item.role === 'user' ? '你' : 'Protein'}}</view><text class="bubble" selectable>{{item.content || (busy ? '正在思考…' : '未收到回复')}}</text></view><view id="bottom" class="bottom"></view>
  </scroll-view>
  <view class="composer"><textarea value="{{input}}" data-field="input" bindinput="field" placeholder="输入消息…" maxlength="20000" auto-height fixed disabled="{{busy}}"/><button wx:if="{{busy}}" bindtap="stop">停止</button><button wx:else class="primary" bindtap="send" disabled="{{!connected || loading || !input}}">发送</button></view>
  <view wx:if="{{showHistory}}" class="overlay"><view class="history"><view class="toolbar"><text class="brand">历史对话</text><button size="mini" bindtap="closeHistory">关闭</button></view><scroll-view scroll-y class="history-list"><view wx:if="{{!history.length}}" class="hint">暂无历史对话</view><button wx:for="{{history}}" wx:key="id" data-index="{{index}}" bindtap="openConversation" disabled="{{loading}}">{{item.title || '新对话'}}</button></scroll-view></view></view>
</view>
